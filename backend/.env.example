# ==============================================
# PRM Tool — Backend Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values
# cp .env.example .env
# ==============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB (local)
MONGODB_URI=mongodb://localhost:27017/prm_tool

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRY=24h

# LLM Configuration
LLM_PROVIDER=GEMINI
LLM_API_KEY=your-gemini-api-key-here

# Scheduler
SCHEDULER_INTERVAL_HOURS=4

# Business Rules
MAX_WEEKLY_HOURS=40
